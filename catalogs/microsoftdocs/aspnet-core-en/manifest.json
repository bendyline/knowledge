{
  "$schema": "../../../schemas/catalog.schema.json",
  "schemaVersion": 1,
  "id": "microsoftdocs-aspnet-core-en",
  "name": "Microsoft technology: ASP.NET Core",
  "description": "Preserved English ASP.NET Core documentation from dotnet/AspNetCore.Docs, with normalized Markdown, selected complete code examples, source revisions, and license notices.",
  "language": "en",
  "enabled": true,
  "contentStorage": "git",
  "publisher": {
    "id": "bendyline",
    "name": "Bendyline",
    "url": "https://github.com/bendyline/knowledge"
  },
  "source": {
    "type": "github",
    "repository": "dotnet/AspNetCore.Docs",
    "ref": "970aa3fd243493b204e11c0f29472fd3f0399fee",
    "paths": [
      "."
    ],
    "include": [
      "aspnetcore/**/*.md"
    ],
    "exclude": [
      "**/wwwroot/lib/**",
      "**/node_modules/**",
      "**/bower_components/**",
      "**/bin/**",
      "**/obj/**",
      "**/package-lock.json",
      "**/docfx.json",
      "**/jquery*.js",
      "**/bootstrap*.js",
      "**/bootstrap*.css",
      "**/knockout*.js",
      "**/modernizr*.js",
      "**/wwwroot/swagger/ui/**",
      "**/signalr/dist/**"
    ],
    "transport": "files",
    "downloadConcurrency": 8,
    "codeFiles": [
      "aspnetcore/**/*.cs",
      "aspnetcore/**/*.vb",
      "aspnetcore/**/*.fs",
      "aspnetcore/**/*.fsx",
      "aspnetcore/**/*.xaml",
      "aspnetcore/**/*.sql",
      "aspnetcore/**/*.json",
      "aspnetcore/**/*.xml",
      "aspnetcore/**/*.config",
      "aspnetcore/**/*.csproj",
      "aspnetcore/**/*.razor",
      "aspnetcore/**/*.cshtml",
      "aspnetcore/**/*.js",
      "aspnetcore/**/*.ts",
      "aspnetcore/**/*.cpp",
      "aspnetcore/**/*.h",
      "aspnetcore/**/*.py",
      "aspnetcore/**/*.ps1",
      "aspnetcore/**/*.sh",
      "aspnetcore/**/*.css",
      "aspnetcore/**/*.html",
      "aspnetcore/**/*.props",
      "aspnetcore/**/*.targets"
    ],
    "docfxRoot": "aspnetcore",
    "maxArchiveBytes": 2000000000,
    "publishedBaseUrl": "https://learn.microsoft.com/aspnet/core/",
    "licenseFiles": [
      {
        "path": "LICENSE",
        "license": "docs"
      },
      {
        "path": "LICENSE-CODE",
        "license": "code"
      }
    ],
    "noticeFiles": [
      {
        "path": "ThirdPartyNotices",
        "sha256": "9a04bd7340ae1cffff45b60b5fbde1b92322228466670fcba41ea672aaca35ed"
      }
    ]
  },
  "licensing": {
    "status": "automatic",
    "policy": "standard-open-v1",
    "notice": "NOTICE.md",
    "licenses": [
      {
        "id": "docs",
        "name": "Creative Commons Attribution 4.0",
        "spdx": "CC-BY-4.0",
        "url": "https://creativecommons.org/licenses/by/4.0/",
        "text": "LICENSES/CC-BY-4.0.txt",
        "attribution": "Microsoft and contributors. Documentation: CC BY 4.0; embedded code: MIT. Adapted by Bendyline through Markdown normalization, include expansion, image omission, and reference conversion. No Microsoft endorsement."
      },
      {
        "id": "code",
        "name": "MIT License",
        "spdx": "MIT",
        "url": "https://opensource.org/license/mit",
        "text": "LICENSES/MIT.txt",
        "attribution": "Copyright (c) Microsoft Corporation and contributors. Code examples retain their MIT license."
      }
    ],
    "rules": [
      {
        "include": [
          "aspnetcore/**/*.md"
        ],
        "license": "docs"
      },
      {
        "include": [
          "_code/**/*.md",
          "aspnetcore/**/*.cs",
          "aspnetcore/**/*.vb",
          "aspnetcore/**/*.fs",
          "aspnetcore/**/*.fsx",
          "aspnetcore/**/*.xaml",
          "aspnetcore/**/*.sql",
          "aspnetcore/**/*.json",
          "aspnetcore/**/*.xml",
          "aspnetcore/**/*.config",
          "aspnetcore/**/*.csproj",
          "aspnetcore/**/*.razor",
          "aspnetcore/**/*.cshtml",
          "aspnetcore/**/*.js",
          "aspnetcore/**/*.ts",
          "aspnetcore/**/*.cpp",
          "aspnetcore/**/*.h",
          "aspnetcore/**/*.py",
          "aspnetcore/**/*.ps1",
          "aspnetcore/**/*.sh",
          "aspnetcore/**/*.css",
          "aspnetcore/**/*.html",
          "aspnetcore/**/*.props",
          "aspnetcore/**/*.targets"
        ],
        "license": "code"
      }
    ]
  },
  "normalization": {
    "images": "omit",
    "docfx": true,
    "docfxReferences": "preserve",
    "docfxMetadataMaxBytes": 12000,
    "docfxProfile": "rendered-v1"
  },
  "sync": {
    "maxFileBytes": 20000000,
    "maxTotalBytes": 1500000000,
    "maxDeleteFraction": 0.2
  },
  "build": {
    "embeddingProfile": "bge-small-en-v1.5@1",
    "toc": {
      "format": "folders"
    },
    "ignore": [
      "**/includes/**"
    ]
  },
  "publish": {
    "enabled": true,
    "huggingFace": "Bendyline/knowledge",
    "github": "bendyline/knowledge",
    "gilde": {
      "repository": "bendyline/gilde",
      "category": "technology",
      "tags": [
        "microsoft",
        "technology",
        "aspnet-core"
      ]
    }
  }
}
