{
  "$schema": "../../../schemas/catalog.schema.json",
  "schemaVersion": 1,
  "id": "microsoftdocs-entity-framework-en",
  "name": "Microsoft technology: Entity Framework",
  "description": "Preserved English Entity Framework documentation from dotnet/EntityFramework.Docs, with normalized Markdown, complete selected code examples, source revisions, and license notices.",
  "language": "en",
  "enabled": true,
  "contentStorage": "git",
  "publisher": {
    "id": "bendyline",
    "name": "Bendyline",
    "url": "https://github.com/bendyline/knowledge"
  },
  "source": {
    "type": "github",
    "repository": "dotnet/EntityFramework.Docs",
    "ref": "fce62a889ce5d100d7961a638dd01dbe2d6c598c",
    "paths": [
      "."
    ],
    "include": [
      "entity-framework/**/*.md"
    ],
    "exclude": [],
    "transport": "archive",
    "codeFiles": [
      "samples/**/*.cs",
      "samples/**/*.vb",
      "samples/**/*.fs",
      "samples/**/*.fsx",
      "samples/**/*.csx",
      "samples/**/*.xaml",
      "samples/**/*.sql",
      "samples/**/*.json",
      "samples/**/*.xml",
      "samples/**/*.config",
      "samples/**/*.csproj",
      "samples/**/*.razor",
      "samples/**/*.cshtml",
      "samples/**/*.js",
      "samples/**/*.ts",
      "samples/**/*.cpp",
      "samples/**/*.h",
      "samples/**/*.py",
      "samples/**/*.ps1",
      "samples/**/*.sh"
    ],
    "docfxRoot": "entity-framework",
    "maxArchiveBytes": 2000000000,
    "publishedBaseUrl": "https://learn.microsoft.com/ef/",
    "licenseFiles": [
      {
        "path": "LICENSE",
        "license": "docs"
      },
      {
        "path": "LICENSE-CODE",
        "license": "code"
      }
    ],
    "noticeFiles": [
      {
        "path": "ThirdPartyNotices",
        "sha256": "9a04bd7340ae1cffff45b60b5fbde1b92322228466670fcba41ea672aaca35ed"
      }
    ]
  },
  "licensing": {
    "status": "automatic",
    "policy": "standard-open-v1",
    "notice": "NOTICE.md",
    "licenses": [
      {
        "id": "docs",
        "name": "Creative Commons Attribution 4.0",
        "spdx": "CC-BY-4.0",
        "url": "https://creativecommons.org/licenses/by/4.0/",
        "text": "LICENSES/CC-BY-4.0.txt",
        "attribution": "Microsoft and contributors. Documentation: CC BY 4.0; embedded code: MIT. Adapted by Bendyline through Markdown normalization, include expansion, image omission, and reference conversion. No Microsoft endorsement."
      },
      {
        "id": "code",
        "name": "MIT License",
        "spdx": "MIT",
        "url": "https://opensource.org/license/mit",
        "text": "LICENSES/MIT.txt",
        "attribution": "Copyright (c) Microsoft Corporation and contributors. Code examples retain their MIT license."
      }
    ],
    "rules": [
      {
        "include": [
          "entity-framework/**/*.md"
        ],
        "license": "docs"
      },
      {
        "include": [
          "_code/**/*.md",
          "samples/**/*.cs",
          "samples/**/*.vb",
          "samples/**/*.fs",
          "samples/**/*.fsx",
          "samples/**/*.csx",
          "samples/**/*.xaml",
          "samples/**/*.sql",
          "samples/**/*.json",
          "samples/**/*.xml",
          "samples/**/*.config",
          "samples/**/*.csproj",
          "samples/**/*.razor",
          "samples/**/*.cshtml",
          "samples/**/*.js",
          "samples/**/*.ts",
          "samples/**/*.cpp",
          "samples/**/*.h",
          "samples/**/*.py",
          "samples/**/*.ps1",
          "samples/**/*.sh"
        ],
        "license": "code"
      }
    ]
  },
  "normalization": {
    "images": "omit",
    "docfx": true,
    "docfxReferences": "preserve"
  },
  "sync": {
    "maxFileBytes": 20000000,
    "maxTotalBytes": 1500000000,
    "maxDeleteFraction": 0.2
  },
  "build": {
    "embeddingProfile": "bge-small-en-v1.5@1",
    "toc": {
      "format": "folders"
    },
    "ignore": [
      "**/includes/**"
    ]
  },
  "publish": {
    "enabled": true,
    "huggingFace": "Bendyline/knowledge",
    "github": "bendyline/knowledge",
    "gilde": {
      "repository": "bendyline/gilde",
      "category": "technology",
      "tags": [
        "microsoft",
        "technology",
        "entity-framework"
      ]
    }
  }
}
