{
  "$schema": "../../../schemas/catalog.schema.json",
  "schemaVersion": 1,
  "id": "microsoftdocs-azure-ai-platform-en",
  "name": "Microsoft technology: Azure AI, Foundry, and Machine Learning",
  "description": "Preserved English Azure AI, Foundry, and Machine Learning documentation from MicrosoftDocs/azure-ai-docs, with normalized Markdown, selected complete code examples, source revisions, and license notices.",
  "language": "en",
  "enabled": true,
  "contentStorage": "git",
  "publisher": {
    "id": "bendyline",
    "name": "Bendyline",
    "url": "https://github.com/bendyline/knowledge"
  },
  "source": {
    "type": "github",
    "repository": "MicrosoftDocs/azure-ai-docs",
    "ref": "766e4b444667054247ad440e9c5a418efa71c050",
    "paths": [
      "articles",
      "agent-framework"
    ],
    "include": [
      "articles/**/*.md",
      "agent-framework/**/*.md"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/bin/**",
      "**/obj/**",
      "**/package-lock.json",
      "**/docfx.json",
      "**/AGENTS.md",
      "**/CLAUDE.md"
    ],
    "transport": "files",
    "downloadConcurrency": 8,
    "codeFiles": [
      "articles/**/*.cs",
      "articles/**/*.ps1",
      "articles/**/*.sh",
      "articles/**/*.py",
      "articles/**/*.js",
      "articles/**/*.ts",
      "articles/**/*.java",
      "articles/**/*.sql",
      "articles/**/*.json",
      "articles/**/*.xml",
      "articles/**/*.config",
      "articles/**/*.csproj",
      "articles/**/*.bicep",
      "articles/**/*.tf",
      "articles/**/*.cpp",
      "articles/**/*.h"
    ],
    "docfxRoot": ".",
    "publishedBaseUrl": "https://learn.microsoft.com/azure/",
    "licenseFiles": [
      {
        "path": "LICENSE",
        "license": "docs"
      },
      {
        "path": "LICENSE-CODE",
        "license": "code"
      }
    ],
    "noticeFiles": [
      {
        "path": "ThirdPartyNotices.md",
        "sha256": "dd2a53262bfad067bab98b0c26934558c19d3512c9fc33bc189d1ed1e5f646ed"
      }
    ]
  },
  "licensing": {
    "status": "automatic",
    "policy": "standard-open-v1",
    "notice": "NOTICE.md",
    "licenses": [
      {
        "id": "docs",
        "name": "Creative Commons Attribution 4.0",
        "spdx": "CC-BY-4.0",
        "url": "https://creativecommons.org/licenses/by/4.0/",
        "text": "LICENSES/CC-BY-4.0.txt",
        "attribution": "Microsoft and contributors. Documentation: CC BY 4.0; embedded code: MIT. Adapted by Bendyline through Markdown normalization, include expansion, image omission, and reference conversion. No Microsoft endorsement."
      },
      {
        "id": "code",
        "name": "MIT License",
        "spdx": "MIT",
        "url": "https://opensource.org/license/mit",
        "text": "LICENSES/MIT.txt",
        "attribution": "Copyright (c) Microsoft Corporation and contributors. Code examples retain their MIT license."
      }
    ],
    "rules": [
      {
        "include": [
          "articles/**/*.md",
          "agent-framework/**/*.md"
        ],
        "license": "docs"
      },
      {
        "include": [
          "_code/**/*.md",
          "articles/**/*.cs",
          "articles/**/*.ps1",
          "articles/**/*.sh",
          "articles/**/*.py",
          "articles/**/*.js",
          "articles/**/*.ts",
          "articles/**/*.java",
          "articles/**/*.sql",
          "articles/**/*.json",
          "articles/**/*.xml",
          "articles/**/*.config",
          "articles/**/*.csproj",
          "articles/**/*.bicep",
          "articles/**/*.tf",
          "articles/**/*.cpp",
          "articles/**/*.h"
        ],
        "license": "code"
      }
    ]
  },
  "normalization": {
    "images": "omit",
    "docfx": true,
    "docfxReferences": "preserve",
    "docfxMetadataMaxBytes": 12000,
    "docfxProfile": "rendered-v1"
  },
  "sync": {
    "maxFileBytes": 20000000,
    "maxTotalBytes": 1500000000,
    "maxDeleteFraction": 0.2
  },
  "build": {
    "embeddingProfile": "bge-small-en-v1.5@1",
    "toc": {
      "format": "folders"
    },
    "ignore": [
      "**/includes/**"
    ]
  },
  "publish": {
    "enabled": true,
    "huggingFace": "Bendyline/knowledge",
    "github": "bendyline/knowledge",
    "gilde": {
      "repository": "bendyline/gilde",
      "category": "technology",
      "tags": [
        "microsoft",
        "technology",
        "azure",
        "ai-platform"
      ]
    }
  }
}
